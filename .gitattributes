# Normalize text to LF in the repo and in every checkout, regardless of
# core.autocrlf, so Prettier and rustfmt agree on all platforms.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.gif binary
*.jpg binary
*.ico binary
*.icns binary
*.zip binary
*.webm binary
*.mp4 binary
